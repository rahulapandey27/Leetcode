Java Solution
/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isEvenOddTree(TreeNode root) {
        //rrot node cannot be xero or null at any given point of time
        Queue<TreeNode> queue =new LinkedList<>();
        queue.offer(root);
        int level=0;//we are going to start from level zero
        while(!queue.isEmpty()){
            int size=queue.size();//getting the size of the queue
            int prev= (level%2==0)? Integer.MIN_VALUE : Integer.MAX_VALUE;/*this willbe checked for the getting to know if the level is even then we have to compare the first elelment of the level to either 0 or infinite */
            for (int i=0; i<size; i++){
                TreeNode curr= queue.poll();
                int val=curr.val;
                if (level%2==0){
                    if(val%2==0 || val<=prev){
                        return false;
                    }
                }
                else {
                    if(val%2!=0 || val>=prev){
                        return false;
                    }
                }
                prev=val;
                if (curr.left != null){
                    queue.offer(curr.left);
                }
                if (curr.right!= null){
                    queue.offer(curr.right);
                }
                

            }level ++;
        }
        return true;
    }
}

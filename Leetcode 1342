resurrsive method

class Solution {
    public int numberOfSteps(int num) {
        //right now we are going to write for recursion
        if(num==0){
            return 0;
        }
        if (num%2==0){
            return 1+ numberOfSteps(num/2);
        }
        else{
            return 1+ numberOfSteps(num-1);
        }
    }
}

Normal Solution
class Solution{
    public int numberOfSteps(int num){
        if (num==0){
            return 0;//tehase contion will always remain same 
        }
        int count=0;
        while(num>0){
            if (num%2==0){
                num=num/2;
            }else {
                num-=1;
            }
            count++;
        }
        return count;
    }
}
